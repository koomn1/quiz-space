{
  "name": "quiz-space-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:auth": "node scripts/save-playwright-state.mjs",
    "qa:e2e": "playwright test --config=qa/playwright.qa.config.ts --workers=1",
    "qa:perf": "playwright test --config=qa/playwright.qa.config.ts --workers=1 --grep 'captures navigation timing'",
    "qa:security": "bash qa/run-security-scan.sh",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capawesome/capacitor-google-sign-in": "0.1.3",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.110.6",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.1",
    "canvas-confetti": "^1.9.4",
    "core-js": "^3.50.0",
    "es-toolkit": "^1.50.0",
    "firebase": "^12.15.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.1",
    "openai": "^6.44.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.1.14",
    "three": "^0.184.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@fontsource/cairo": "5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.7.0",
    "gh-pages": "^6.3.0",
    "supabase": "^2.111.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
