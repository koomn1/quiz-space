# =====================================================================
# QuizSpace - Environment Configuration Template
# =====================================================================
# Copy this file to .env or configure in your deployment platform.
# All VITE_* variables are embedded at build time into the client bundle.
# Non-VITE variables are strictly for backend workers, CI/CD, and scripts.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Supabase Client Configuration (Required for client data & auth)
# ---------------------------------------------------------------------
# From: https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_FUNCTION_URL=https://xxxxxxxxxxxx.supabase.co/functions/v1

# ---------------------------------------------------------------------
# 2. Cloudflare Worker AI Proxy (Required for AI generation & chat)
# ---------------------------------------------------------------------
VITE_AI_WORKER_URL=https://quiz-space-ai.<your-subdomain>.workers.dev
ESSAY_GRADING_UI_BASE_URL=https://quiz-space.app

# ---------------------------------------------------------------------
# 3. Worker Internal Secrets (Configured via `wrangler secret put`)
# ---------------------------------------------------------------------
# Shared HMAC secret for verifying classroom internal service calls
CLASSROOM_SECRET=your-random-32-char-classroom-secret-key-here
# Shared secret for scheduled cron promotions and resets
PROMOTION_CRON_SECRET=your-random-32-char-cron-secret-key-here

# ---------------------------------------------------------------------
# 4. Third-Party Integrations
# ---------------------------------------------------------------------
# Google OAuth Client ID for Google Drive document import
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Web OAuth Client ID used by native Android Google Sign-In
VITE_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Tavily API key for live web search and source citation in Cosmo AI
VITE_TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# 5. Testing, QA & End-to-End (E2E) Automation
# ---------------------------------------------------------------------
CI=false
DEPLOY_TARGET=preview
DISABLE_HMR=false
PLAYWRIGHT_BASE_URL=http://localhost:5173
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
PLAYWRIGHT_STORAGE_STATE=playwright/.auth/user.json
QA_BASE_URL=http://localhost:5173
QA_TEST_COUPON=TEST100OFF
QA_TEST_EMAIL=test-user@quiz-space.app
QA_TEST_PASSWORD=SecureTestPassword123!
E2E_PROFILE_ID=user-demo-e2e-id

# ---------------------------------------------------------------------
# 6. Mobile Application Packaging (Capacitor / Android)
# ---------------------------------------------------------------------
VERSION_CODE=1
VERSION_NAME=1.0.0
ANDROID_KEY_ALIAS=quizspace-key
ANDROID_KEYSTORE_PASSWORD=your-secure-keystore-password
ANDROID_KEYSTORE_BASE64=
ASSETLINKS_OUTPUT=dist/.well-known/assetlinks.json

# =====================================================================
# SECURITY NOTICE:
# Provider API keys (OpenAI, Gemini, Groq, Inception, OpenRouter) must
# NEVER be placed in client-side bundles. Store them as Wrangler secrets.
# =====================================================================
