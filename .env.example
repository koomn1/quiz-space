# Supabase project config - from your Supabase project's Settings > API page.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Worker URL for AI generation endpoints (OpenRouter/OpenAI/Groq/DeepSeek proxy)
VITE_AI_WORKER_URL=https://quiz-space-ai.<your-subdomain>.workers.dev

# Google OAuth Client ID for Google Drive linking feature.
# From: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Web OAuth Client ID used by the native Android Google account picker.
VITE_GOOGLE_WEB_CLIENT_ID=

# OpenRouter API Key for direct client AI fallback (optional - set in GitHub Secrets)
# Get one at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
